# ==========================================================================
# Hytale Server Manager — Docker Compose Environment Variables
# ==========================================================================
# Copy to .env and fill in values before running docker compose up.
#
# Single-node:   docker compose up -d
# Multi-node:    docker compose --profile multi-node up -d
# ==========================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────
# Password for the hsm PostgreSQL user. REQUIRED.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Security Secrets ───────────────────────────────────────────────────
# All secrets below are REQUIRED and must be identical across all nodes.
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# Exactly 32 hex characters. Generate with: openssl rand -hex 16
SETTINGS_ENCRYPTION_KEY=

# ── Multi-Node Cluster (optional) ─────────────────────────────────────
# Secret for authenticating internal node-to-node API calls.
# All nodes MUST share the same value. Leave empty for single-node.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=

# ── Application Settings ──────────────────────────────────────────────
# CORS origin — set to your server's public URL for external access
CORS_ORIGIN=http://localhost:3001

# Set to true when NOT using HTTPS (local/dev only, NOT recommended for production)
INSECURE_COOKIES=true

# ── Host Ports (change if defaults conflict) ──────────────────────────
# HSM_NODE1_PORT=3001
# HSM_NODE2_PORT=3002

# ── Container User/Group IDs ──────────────────────────────────────────
# PUID=1000
# PGID=1000

# ── Timezone ───────────────────────────────────────────────────────────
# TZ=Etc/UTC

# ── Rate Limiting ─────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW=900000
# RATE_LIMIT_MAX=1000
# MAX_FILE_UPLOAD_SIZE=52428800
