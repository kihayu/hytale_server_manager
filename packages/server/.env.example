# Hytale Server Manager - Server Configuration
# Copy this file to .env and configure required values

# ===========================================
# REQUIRED - Server will not start without these
# ===========================================

# JWT secrets for authentication (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encryption key for sensitive settings (exactly 32 characters)
# Generate with: openssl rand -hex 16
SETTINGS_ENCRYPTION_KEY=

# ===========================================
# Database (PostgreSQL)
# ===========================================

# PostgreSQL connection URL
# Docker default: postgresql://hsm:<POSTGRES_PASSWORD>@postgres:5432/hytale_manager
DATABASE_URL=postgresql://hsm:your_password@localhost:5432/hytale_manager

# ===========================================
# Redis
# ===========================================

# Redis connection URL (used for pub/sub WebSocket broadcasting and caching)
# Docker default: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ===========================================
# Server Configuration
# ===========================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ===========================================
# Paths
# ===========================================

# Base path for server installations
SERVERS_BASE_PATH=./servers

# Base path for backups
BACKUPS_BASE_PATH=./backups

# Logs directory
LOGS_PATH=./logs

# ===========================================
# HTTPS / SSL
# ===========================================

# In production, HTTPS is required by default (secure cookies enabled)
# Set INSECURE_COOKIES=true to allow HTTP access (NOT recommended, only for local testing)
# INSECURE_COOKIES=true

# Path to SSL certificates (for direct HTTPS without reverse proxy)
# CERTS_PATH=./certs

# ===========================================
# Logging
# ===========================================

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# ===========================================
# JWT Settings
# ===========================================

# Access token expiration (default: 15m)
JWT_EXPIRES_IN=15m

# ===========================================
# WebSocket
# ===========================================

WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=60000

# ===========================================
# Rate Limiting
# ===========================================

# Rate limit window in milliseconds (default: 15 minutes)
# RATE_LIMIT_WINDOW=900000

# Max requests per window (default: 1000)
# RATE_LIMIT_MAX=1000

# Max file upload size in bytes (default: 50MB)
# MAX_FILE_UPLOAD_SIZE=52428800

# ===========================================
# Discord Notifications (optional)
# ===========================================

DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Hytale Server Manager
DISCORD_AVATAR_URL=
DISCORD_MENTION_ROLE_ID=

# ===========================================
# FTP Remote Backup Storage (optional)
# ===========================================

FTP_ENABLED=false
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_SECURE=false

# ===========================================
# Multi-Node Cluster (optional)
# ===========================================
# These settings enable horizontal scaling with multiple HSM instances.
# In single-node mode, leave these unset — everything works automatically.

# Unique node ID (auto-generated from hostname if not set).
# Must be unique across all nodes in the cluster.
# NODE_ID=node-1

# Internal HTTP address reachable by other nodes (for cross-node command routing).
# Leave unset for single-node deployments.
# NODE_ID=node-1         → INTERNAL_ADDRESS=http://hsm-node-1:3001
# NODE_ID=node-2         → INTERNAL_ADDRESS=http://hsm-node-2:3001
# INTERNAL_ADDRESS=http://localhost:3001

# Shared secret for authenticating internal node-to-node API calls.
# All nodes MUST use the same value. Leave unset for single-node mode.
# Generate with: openssl rand -hex 32
# INTERNAL_SECRET=

# Skip database schema push on startup (for secondary nodes).
# Set to true on all nodes except the primary to avoid concurrent schema pushes.
# SKIP_DB_PUSH=true
